{
  "name": "sabit-kiymet",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c gray,blue \"npm:api\" \"npm:web\"",
    "web": "vite",
    "api": "json-server server/db.json --port 3001 --delay 300 --middlewares server/middleware.cjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "formik": "^2.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "json-server": "0.17.4",
    "sass": "^1.80.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
